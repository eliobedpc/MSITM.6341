#!/usr/bin/env python3
"""
Lesson 5 Take-Home Assignment: Pandas + NumPy Pipeline
=======================================================
"""

import os

try:
    import pandas as pd
except ImportError:
    pd = None

# Keep file behavior consistent from any launch location.
os.chdir(os.path.dirname(os.path.abspath(__file__)))


def pandas_numpy_assignment():
    """
    Build a mini analysis pipeline using pandas and NumPy.
    """
    print("\n--- Lesson 5 Assignment: Pandas + NumPy Pipeline ---")

    if pd is None:
        print("Pandas is not installed. Install it before completing this task.")
        return

    # Import NumPy inside the function.
    try:
        import numpy as np
    except ImportError:
        print("NumPy is not installed. Install it before completing this task.")
        return

    # Step 1: Create sample data and a DataFrame.
    data = {
        "Student": ["Alice", "Bob", "Charlie", "Diana", "Edward"],
        "Math": [88, 92, 79, 85, 90],
        "Science": [91, 85, 88, 90, 86],
        "English": [85, 87, 90, 82, 88],
    }

    df = pd.DataFrame(data)

    print("\nStudent Data:")
    print(df.head())

    # Step 2: Convert score columns into a NumPy array.
    score_columns = ["Math", "Science", "English"]

    scores_array = df[score_columns].to_numpy()

    print("\nNumPy Score Array:")
    print(scores_array)

    # Step 3: Compute per-student averages with NumPy.
    student_averages = np.mean(
        scores_array,
        axis=1
    )

    print("\nStudent Averages:")
    print(student_averages)

    # Step 4: Add average scores back into the DataFrame.
    df["Average"] = student_averages

    print("\nDataFrame with Average Scores:")
    print(df)

    # Step 5: Compute class-level subject averages with pandas.
    subject_averages = df[
        ["Math", "Science", "English"]
    ].mean()

    print("\nClass Subject Averages:")
    print(subject_averages)

    # Step 6: Filter students above the class Math average.
    math_average = df["Math"].mean()

    above_average_math = df[
        df["Math"] > math_average
    ]

    print(
        f"\nClass Math Average: "
        f"{math_average:.2f}"
    )

    print("\nStudents Above the Math Average:")
    print(
        above_average_math[
            ["Student", "Math"]
        ]
    )


if __name__ == "__main__":
    pandas_numpy_assignment()
