def numpy_exercise():
    """
    Practice NumPy matrix creation and summary statistics.
    """

    print("\n--- NumPy Exercise ---")

    # Ask user for matrix size.
    size = int(input("Enter the size of the square matrix: "))

    # Create a random square matrix.
    matrix = np.random.randint(
        1,
        101,
        size=(size, size)
    )

    print("\nRandom Matrix:")
    print(matrix)

    # Compute row means.
    row_means = np.mean(
        matrix,
        axis=1
    )

    # Compute column means.
    column_means = np.mean(
        matrix,
        axis=0
    )

    print("\nRow Means:")
    print(row_means)

    print("\nColumn Means:")
    print(column_means)


def pandas_filter_exercise():
    """
    Practice DataFrame filtering based on user input.
    """

    print("\n--- Pandas Filter Exercise ---")

    team = input(
        "Enter a team name: "
    )

    filtered_data = df_nba[
        df_nba["Team"] == team
    ]

    if filtered_data.empty:
        print("No players found for that team.")
    else:
        print("\nMatching Players:")
        print(filtered_data)


def normalization_exercise():
    """
    Practice min-max normalization on one selected stat column.
    """

    print("\n--- Normalization Exercise ---")

    column = input(
        "Choose a column to normalize (PPG/APG/RPG): "
    ).upper()

    if column not in ["PPG", "APG", "RPG"]:
        print("Invalid column selection.")
        return

    minimum = df_nba[column].min()
    maximum = df_nba[column].max()

    normalized_column = column + "_Normalized"

    df_nba[normalized_column] = (
        df_nba[column] - minimum
    ) / (
        maximum - minimum
    )

    print(
        df_nba[
            ["Player", column, normalized_column]
        ]
    )


def eda_exercise():
    """
    Compute aggregate stats for one selected numeric column.
    """

    print("\n--- EDA Exercise ---")

    column = input(
        "Choose a stat column (PPG/APG/RPG): "
    ).upper()

    if column not in ["PPG", "APG", "RPG"]:
        print("Invalid column selection.")
        return

    mean_value = df_nba[column].mean()
    median_value = df_nba[column].median()
    std_value = df_nba[column].std()

    print(
        f"\nMean {column}: "
        f"{mean_value:.2f}"
    )

    print(
        f"Median {column}: "
        f"{median_value:.2f}"
    )

    print(
        f"Standard Deviation {column}: "
        f"{std_value:.2f}"
    )


def visualization_exercise():
    """
    Generate one selected chart.
    """

    print("\n--- Visualization Exercise ---")

    print("1. Histogram")
    print("2. Scatter Plot")
    print("3. Boxplot")

    choice = input(
        "Choose a plot (1/2/3): "
    )

    if choice == "1":

        plt.hist(
            df_nba["PPG"],
            bins=5
        )

        plt.title(
            "NBA Points Per Game"
        )

        plt.xlabel(
            "Points Per Game"
        )

        plt.ylabel(
            "Frequency"
        )

        plt.show()

    elif choice == "2":

        plt.scatter(
            df_nba["PPG"],
            df_nba["APG"]
        )

        plt.title(
            "Points vs Assists"
        )

        plt.xlabel(
            "Points Per Game"
        )

        plt.ylabel(
            "Assists Per Game"
        )

        plt.show()

    elif choice == "3":

        sns.boxplot(
            y=df_nba["RPG"]
        )

        plt.title(
            "Rebounds Per Game"
        )

        plt.ylabel(
            "Rebounds Per Game"
        )

        plt.show()

    else:
        print("Invalid plot selection.")


